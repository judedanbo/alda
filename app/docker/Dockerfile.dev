FROM node:25-alpine

# Set working directory
WORKDIR /app

# Install libc6-compat for Prisma
RUN apk add --no-cache libc6-compat

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy rest of the application
COPY . .

# Expose port
EXPOSE 3000

# Generate Prisma client at startup (after node_modules volume is mounted),
# then start the dev server
CMD ["sh", "-c", "npx prisma generate && npm run dev -- --host 0.0.0.0"]
