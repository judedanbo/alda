# Database
DATABASE_URL="postgresql://adla:adla@localhost:5432/adla?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# MinIO Configuration
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="adla-uploads"

# Email Configuration
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@adla.gov.gh"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Application
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================================
# Notification queue (BullMQ-backed dispatch)
# ============================================================
# Default ON when REDIS_URL is set. Flips email/SMS dispatch from inline
# (blocks the request) to a background worker with retries.
NOTIFICATIONS_QUEUE_ENABLED="true"
# Whether THIS instance runs the worker (set false on web-only pods).
NOTIFICATIONS_WORKER_ENABLED="true"
# Per-queue worker concurrency.
NOTIFICATIONS_EMAIL_CONCURRENCY="5"
NOTIFICATIONS_SMS_CONCURRENCY="5"
# Max attempts (BullMQ uses exponential backoff: 30s, 5m, 30m, ...).
NOTIFICATIONS_MAX_ATTEMPTS="3"
# Retention for the daily notifications:prune task (days).
NOTIFICATIONS_READ_RETENTION_DAYS="90"
NOTIFICATIONS_UNREAD_RETENTION_DAYS="180"
# Per-user-per-type ceiling (runaway-bug fuse). Security/transactional
# types (password reset, email verification) bypass this.
NOTIFICATIONS_RATE_LIMIT_PER_HOUR="10"

# ============================================================
# Web Analytics, Abuse Detection & Rate Limiting
# ============================================================
# Master switch and per-subsystem toggles
ANALYTICS_ENABLED="true"
ANALYTICS_CAPTURE_ENABLED="true"
ANALYTICS_ABUSE_ENABLED="true"
ANALYTICS_AI_DETECTION_ENABLED="true"
ANALYTICS_RATE_LIMIT_ENABLED="true"

# Privacy: salt used to hash client IPs (CHANGE IN PRODUCTION). Honour DNT.
ANALYTICS_IP_SALT="change-this-analytics-ip-salt-in-production"
ANALYTICS_RESPECT_DNT="true"

# Retention (days). Raw traffic events pruned past retention; rollups kept longer.
ANALYTICS_RETENTION_DAYS="30"
ANALYTICS_ROLLUP_RETENTION_DAYS="365"

# Comma-separated path prefixes excluded from capture/enforcement
ANALYTICS_EXCLUDE_PATHS="/_nuxt,/__nuxt,/_ipx,/favicon.ico,/api/health,/api/admin/analytics"

# Counter storage: "redis" (shared, correct across instances) or "memory"
# (per-instance). Falls back to memory automatically when REDIS_URL is unset.
ANALYTICS_STORAGE_DRIVER="redis"

# Sessionization: anonymous-visitor session inactivity window (minutes)
ANALYTICS_SESSION_WINDOW_MINUTES="30"

# Rate limits (sliding window). Requests allowed per window.
ANALYTICS_RL_IP_PER_MIN="300"
ANALYTICS_RL_AUTH_PER_MIN="15"
ANALYTICS_RL_WRITE_PER_MIN="90"
ANALYTICS_RL_UPLOAD_PER_5MIN="30"
ANALYTICS_RL_USER_PER_MIN="600"
# Multipliers applied to limits for flagged actors (0-1, lower = stricter)
ANALYTICS_RL_ABUSIVE_MULTIPLIER="0.2"
ANALYTICS_RL_AI_THROTTLE_MULTIPLIER="0.25"

# Abuse detection thresholds
ANALYTICS_ABUSE_FLOOD_PER_MIN="600"
ANALYTICS_ABUSE_ERROR_RATE="0.6"
ANALYTICS_ABUSE_DISTINCT_404="12"
ANALYTICS_ABUSE_FAILED_LOGINS="8"
ANALYTICS_ABUSE_SUSPICIOUS_SCORE="40"
ANALYTICS_ABUSE_ABUSIVE_SCORE="75"
ANALYTICS_ABUSE_BLOCK_MINUTES="30"

# AI crawler policy per category: allow | log | throttle | block
ANALYTICS_AI_TRAINING_POLICY="block"
ANALYTICS_AI_SEARCH_POLICY="allow"
ANALYTICS_AI_LIVE_RETRIEVAL_POLICY="log"
ANALYTICS_AI_UNKNOWN_POLICY="throttle"
ANALYTICS_AI_ROBOTS_ENFORCEMENT="true"
ANALYTICS_AI_IP_RANGE_REFRESH_HOURS="24"
